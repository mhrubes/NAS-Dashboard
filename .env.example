# Zkopiruj do .env a vypln. Hash a secret vygeneruj: npm run hash -- "heslo"
# (heslo se pouziva jen pro upravy seznamu aplikaci, zobrazeni je bez prihlaseni)
APP_PASSWORD_HASH=
SESSION_SECRET=

# Port vystaveny na NASu (docker compose)
APP_PORT=1000

# Za HTTPS reverse proxy nastav obe na true
COOKIE_SECURE=false
TRUST_PROXY=false
